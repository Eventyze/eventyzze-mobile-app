{
  "expo": {
    "name": "Eventyzze",
    "slug": "eventyzze2",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/general/eventyzze-logo.png",
    "scheme": "myapp",
    "platforms": [
      "ios",
      "android"
    ],
    "deeplink": "myapp://",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.eventyzze.app",
      "userInterfaceStyle": "light",
      "splash": {
        "image": "./assets/general/eventyzze-logo.png",
        "resizeMode": "contain",
        "backgroundColor": "#000000"
      }
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/general/eventyzze-logo.png",
        "backgroundColor": "#000000",
        "intentFilters": [
          {
            "action": "VIEW",
            "data": [
              {
                "scheme": "myapp",
                "host": "payment-callback"
              }
            ],
            "category": [
              "BROWSABLE",
              "DEFAULT"
            ]
          },
          {
            "action": "VIEW",
            "data": [
              {
                "scheme": "myapp",
                "host": "payment-callback"
              }
            ],
            "category": [
              "BROWSABLE",
              "DEFAULT"
            ]
          }
        ]
      },
      "package": "com.eventyzze.app",
      "scheme": "myapp",
      "minSdkVersion": 21,
      "targetSdkVersion": 34,
      "userInterfaceStyle": "light"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/general/eventyzze-logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/general/eventyzze-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "09dda1c8-a0b7-45af-ade8-c484105cc108"
      }
    },
    "owner": "akem",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/09dda1c8-a0b7-45af-ade8-c484105cc108"
    }
  }
}
